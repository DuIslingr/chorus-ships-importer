<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reads Chorus's pak with CUE4Parse (https://github.com/FabianFG/CUE4Parse). Point CUE4ParseDir at a checkout:
       dotnet build -c Release -p:CUE4ParseDir=/path/to/CUE4Parse (import.py does this from its "cue4parse" setting). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AssemblyName>ChorusExport</AssemblyName>
    <CUE4ParseDir Condition="'$(CUE4ParseDir)' == ''">$(MSBuildThisFileDirectory)../../CUE4Parse</CUE4ParseDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse/CUE4Parse.csproj" />
    <ProjectReference Include="$(CUE4ParseDir)/CUE4Parse-Conversion/CUE4Parse-Conversion.csproj" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>
</Project>
